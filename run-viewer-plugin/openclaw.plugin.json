{
  "id": "run-viewer",
  "uiHints": {
    "runsDir": {
      "label": "Run Store Directory",
      "placeholder": "~/.openclaw/runs"
    },
    "listLimit": {
      "label": "Default List Limit"
    },
    "healthTimeZone": {
      "label": "Health Timezone",
      "placeholder": "UTC or Asia/Tokyo"
    }
  },
  "configSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "enabled": { "type": "boolean" },
      "runsDir": { "type": "string" },
      "listLimit": { "type": "number" },
      "healthTimeZone": { "type": "string" }
    }
  }
}
